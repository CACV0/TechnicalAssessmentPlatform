{
  "name": "TechnicalAssessmentPlatform",
  "version": "1.0.0",
  "description": "Backend API for a technical assessment platform that manages assessments, coding challenges, submissions, code execution, and automated evaluation.",
  "main": "build/bin/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/bin/server.ts",
    "build": "tsc",
    "start": "npm run build && node build/bin/server.js",
    "test": "jest --config=jest.config.js --no-cache",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "keywords": [
    "typescript",
    "nodejs",
    "express",
    "jest",
    "tslint"
  ],
  "author": "CACV",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dateformat": "^3.0.3",
    "debug": "^4.3.4",
    "express": "^4.18.2",
    "express-actuator": "^1.0.0",
    "express-openapi-validator": "5.6.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.2",
    "@types/cors": "^2.8.17",
    "@types/dateformat": "^5.0.0",
    "@types/debug": "^4.1.9",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.3",
    "@types/node": "^20.4.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^5.16.0",
    "@typescript-eslint/parser": "^5.16.0",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-unused-imports": "^2.0.0",
    "jest": "^29.6.1",
    "nodemon": "^3.1.14",
    "prettier": "^2.8.8",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tslint": "^6.1.3",
    "typescript": "^5.1.6"
  }
}
